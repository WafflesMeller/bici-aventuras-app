{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/icons/(.*)",
      "destination": "/icons/$1"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/registerSW.js",
      "destination": "/registerSW.js"
    },
    {
      "source": "/((?!icons|api|manifest|registerSW|pwa-|sw.js).*)",
      "destination": "/index.html"
    }
  ]
}